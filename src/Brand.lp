import Events
set_option synthInstance.maxSize 4096
/-!
# `Site.Brand` : Official Lakeport Outlined Logos & Evidence Vocabulary

Generated directly from `assets/brand/logo/*.svg` (`brand/tools/gen.py` outlines):
- `primaryLogo`: `lakeport-logo.svg` (`Lake / Port` two-deck logotype, min height `56px`)
- `logoLockup`: `lakeport-logo-horizontal.svg` (mark + outlined Geist SemiBold wordmark for nav/footer)
- `logoMark`: `lakeport-mark.svg` (`64×64` mark)
- `EvState` / `evidenceItem`: `● proved`, `◐ trusted`, `○ unknown`, `✕ failed`
-/
namespace Site.Brand
open LakeportStyle Site

abbrev V := StyledView UiEvent Nat

@[default_instance] instance {E F : Type} : ToChildren (List (StyledView E F)) E F :=
  ⟨fun xs => xs.zipIdx.map fun (v, i) => (some i, v)⟩

