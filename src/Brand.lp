/-- Primary `Lake / Port` two-deck logotype (`viewBox="18.5 3.875 119.250 56.250"`, minimum `56px` tall).
    Used in heroes and the `/docs` landing header with >= 3.5u clear space on every side. -/
def primaryLogo (variant : String := "hero") : V :=
  <div class="brand-primary-frame" data-variant={variant}>
    <span class="brand-primary-svg" data-variant={variant} data-lp-svg="18.5 3.875 119.250 56.250">
      <span class="mark-upper" data-lp-svg-shape="path" data-lp-d={logoUpperPath} />
      <span class="mark-reflection" data-lp-svg-shape="path" data-lp-d={logoReflectionPath} />
    </span>
  </div>

/-- Horizontal lockup (`viewBox="18.5 3.875 135.29 56.25"`, mark + outlined Geist SemiBold wordmark).
    Used in tight horizontal spaces (`header` nav and `footer`). -/
def logoLockup (variant : String := "header") : V :=
  <span class="brand-lockup-svg" data-variant={variant} data-lp-svg="18.5 3.875 135.29 56.25">
    <span class="mark-upper" data-lp-svg-shape="path" data-lp-d={markUpperPath} />
    <span class="mark-reflection" data-lp-svg-shape="path" data-lp-d={markReflectionPath} />
    <span class="mark-word" data-lp-svg-shape="path" data-lp-d={wordmarkPath} />
  </span>

/-! ## Four-State Verification Evidence Vocabulary -/

inductive EvState where
  | proved
  | trusted
  | unknown
  | failed
  deriving DecidableEq, Repr

namespace EvState

def tag : EvState → String
  | .proved => "proved"
  | .trusted => "trusted"
  | .unknown => "unknown"
  | .failed => "failed"

def glyph : EvState → String
  | .proved => "●"
  | .trusted => "◐"
  | .unknown => "○"
  | .failed => "✕"

def word : EvState → String
  | .proved => "proved"
  | .trusted => "trusted"
  | .unknown => "unknown"
  | .failed => "failed"

end EvState

/-- Semantic verification evidence item: always renders glyph + word + statement. -/
def evidenceItem (st : EvState) (statement : String) (mono : Bool := true) : V :=
  <div class="ev-item" data-ev={st.tag}>
    <span class="ev-badge">
      <span class="ev-glyph">{st.glyph}</span>
      <span class="ev-word">{st.word}</span>
    </span>
    <span class="ev-detail" data-mono={mono}>{statement}</span>
  </div>

end Site.Brand
