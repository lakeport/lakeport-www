{
  "name": "@lakeport/www",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lakeport marketing website and documentation manual deployed to lakeport.dev",
  "license": "Apache-2.0",
  "scripts": {
    "sync:mdx": "python3 tools/sync_mdx.py",
    "check": "node tools/lakeport-run.mjs check .",
    "build": "python3 tools/sync_mdx.py && node tools/lakeport-run.mjs build web . --release",
    "test": "python3 tests/check-negative-v3.py && node tests/smoke-wasm.mjs",
    "dev:worker": "wrangler dev",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.162.0"
  }
}
